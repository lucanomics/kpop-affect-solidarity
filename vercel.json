{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-site.js",
  "outputDirectory": "public",
  "installCommand": "echo 'no runtime dependencies — the PDFs are pre-built and committed'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/files/(.*).pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
